<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- xUnit1026：theory 的 medium/swarm 参数用于用例命名显示（xunit 以参数值命名）——刻意保留；
         xUnit1031：FsRaftStore 同步装配 helper 的 sync-over-async（测试无同步上下文死锁面） -->
    <!-- CA2252/CA1416：MsQuic 预览面 + 平台标注——测试以 QuicListener.IsSupported 环境门控（AGENTS §4.3 合法门控例外） -->
    <NoWarn>$(NoWarn);xUnit1026;xUnit1031;CA2252;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TC.Tier.Core.Net\TC.Tier.Core.Net.csproj" />
    <ProjectReference Include="..\..\src\TC.Tier.Core\TC.Tier.Core.csproj" />
    <ProjectReference Include="..\..\src\TC.Tier.Runtime\TC.Tier.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
