<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12.0</LangVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA1707,CA1716,CA1852,CA2201,xUnit1000,xUnit1031,CS0618,NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TC.Tier.Runtime\TC.Tier.Runtime.csproj" />
    <ProjectReference Include="..\..\src\TC.Tier.Core\TC.Tier.Core.csproj" />
  </ItemGroup>
  <!-- ★ 对抗性测试（故障注入 / 并发压测 / soak / 大规格完整性）独立项目——2026-08-21 用户裁定：
       这些类别在真磁盘介质上以挂起/慢时序为常态（隔离复现即存在），与单元测试混合会拖垮
       整个单测套件（每次全量卡死）。单测项目保持秒级干净，对抗性项目单独跑、单独取证。 -->
  <!-- ★ 共享基础设施从单测项目链接（单一真源，不复制）：TestVolume 组合根 + TestTempDir + GlobalUsings。
       大规格 Scale 测试（Structures/RingRecoveryScaleTests，Category=Scale）物理归属本项目——
       测试类不跨项目链接（链接只用于零用例的基建；手动/Nightly 按 Trait Category=Scale 过滤跑）。 -->
  <ItemGroup>
    <Compile Include="..\TC.Tier.Runtime.Tests\TestVolume.cs" Link="TestVolume.cs" />
    <Compile Include="..\TC.Tier.Runtime.Tests\TestTempDir.cs" Link="TestTempDir.cs" />
    <Compile Include="..\TC.Tier.Runtime.Tests\TestConsoleLogger.cs" Link="TestConsoleLogger.cs" />
    <Compile Include="..\TC.Tier.Runtime.Tests\GlobalUsings.cs" Link="GlobalUsings.cs" />
    <Compile Include="..\TC.Tier.Runtime.Tests\Storage\StorageEngineTestBase.cs" Link="Storage\StorageEngineTestBase.cs" />
  </ItemGroup>
  <!-- ★ xunit.runner.json 复制到输出目录（禁用并行执行，避免磁盘 IO 竞争导致 flaky——同单测项目） -->
  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
