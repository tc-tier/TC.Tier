<Project Sdk="Microsoft.NET.Sdk">
  <!-- ★ 对比基准专用（唯一 FASTER 依赖点）：本仓库存储栈 100% 自研（NativeInterop→Core/IO 三介质→Runtime 自有 IO 层），
       FASTER 仅用于性能对照（同 MemVsRawProbe 定位）。勿在 src 生产代码中引用 FASTER。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.FASTER.Core" />
  </ItemGroup>
  <ItemGroup>
    <!-- 嵌套独立工程（Raft API 反射实验）——SDK 通配须显式排除，否则双顶级语句冲突 -->
    <Compile Remove="ApiExplorer\**" />
  </ItemGroup>
</Project>
