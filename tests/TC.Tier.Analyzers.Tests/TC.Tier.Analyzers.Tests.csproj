<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CA1707,CA1716,CA1852,CA2201,xUnit1000,xUnit1031,CS0618,CS1998,NU1507</NoWarn>
  </PropertyGroup>

  <!-- ★ 配置化分析器测试：CSharpCompilation + CompilationWithAnalyzers 直驱（与现仓零新测试依赖
       哲学一致，不引 Microsoft.CodeAnalysis.Testing）；TC.Tier.Analyzers 需普通引用直接实例化
       分析器（全局 analyzer 注入已在 Directory.Build.props 对本项目豁免）。 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TC.Tier.Analyzers\TC.Tier.Analyzers.csproj" />
  </ItemGroup>

</Project>
