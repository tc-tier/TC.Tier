is_global = true

# ============================================================
# 严重级别策略：
#   - Performance（性能）/ Security（安全）/ Reliability（资源未释放、线程安全）
#       → 最低 warning（会出现在编译输出，必须关注）
#   - Naming（命名）/ Design（设计）/ Globalization（全球化）/ Usage（日志模板等）
#       → suggestion（IDE 提醒，不阻塞）
# ============================================================

# ---- Compiler warnings (intentional patterns) → none ----
dotnet_diagnostic.CS0414.severity = none   # 字段已赋值但未使用（预留字段/两阶段初始化）
dotnet_diagnostic.CS0169.severity = none   # 字段从未使用（同上）
dotnet_diagnostic.CS0108.severity = none   # 隐藏继承成员（abstract 子类 override）
dotnet_diagnostic.CS0420.severity = none   # volatile 字段 ref 传递（Volatile.Read 已知模式）
dotnet_diagnostic.CS8618.severity = none   # 不可为 null 字段未初始化（两阶段 init 模式）

# ---- Reliability（资源未释放 / 线程安全）→ warning ----
dotnet_diagnostic.CA1001.severity = warning   # 可释放字段但类型未实现 IDisposable
dotnet_diagnostic.CA2211.severity = warning   # 非常量静态字段不应可见（线程安全）

# ---- Performance（性能）→ warning ----
dotnet_diagnostic.CA1805.severity = warning   # 不必要的赋值（类型已相同）
dotnet_diagnostic.CA1806.severity = warning   # 方法返回值未使用
dotnet_diagnostic.CA1816.severity = warning   # Dispose 应调用 GC.SuppressFinalize
dotnet_diagnostic.CA1822.severity = none      # 成员可标记为 static（全局忽略）
dotnet_diagnostic.CA1836.severity = warning   # 优先使用 Count 而非 Any()
dotnet_diagnostic.CA1845.severity = warning   # 使用 string.Concat / span 替代 Substring
dotnet_diagnostic.CA1847.severity = warning   # 字符串比较使用 char 重载
dotnet_diagnostic.CA1848.severity = warning   # 在 LoggerMessage 上使用 partial
dotnet_diagnostic.CA1854.severity = warning   # 用 TryGetValue 替代 ContainsKey + Item
dotnet_diagnostic.CA1855.severity = warning   # 使用 span 的 LastIndexOf 重载
dotnet_diagnostic.CA1859.severity = warning   # 尽可能使用具体类型提升分派性能

# ---- Security（安全）→ warning ----
dotnet_diagnostic.CA2020.severity = warning   # 位运算符产生的意外类型
dotnet_diagnostic.CA2101.severity = warning   # P/Invoke 字符串参数应指定字符集
dotnet_diagnostic.CA2201.severity = warning   # 不要抛出保留的异常类型

# ---- Design（设计约定）→ suggestion ----
dotnet_diagnostic.CA1000.severity = suggestion # 不要在泛型类型中声明静态成员
dotnet_diagnostic.CA1051.severity = suggestion # 不要声明可见的实例字段
dotnet_diagnostic.CA1068.severity = suggestion # CancellationToken 应作为最后一个参数

# ---- Naming（命名约定）→ suggestion ----
dotnet_diagnostic.CA1707.severity = suggestion # 标识符不应包含下划线
dotnet_diagnostic.CA1708.severity = suggestion # 标识符的区分不应仅大小写
dotnet_diagnostic.CA1711.severity = suggestion # 标识符不应有错误的后缀
dotnet_diagnostic.CA1715.severity = suggestion # 标识符应具有正确的前缀
dotnet_diagnostic.CA1716.severity = suggestion # 标识符不应与关键字冲突
dotnet_diagnostic.CA1720.severity = suggestion # 标识符不应与类型名冲突
dotnet_diagnostic.CA1725.severity = suggestion # 参数名应与基声明一致
dotnet_diagnostic.CA1727.severity = suggestion # 命名空间使用 PascalCasing

# ---- Globalization（全球化）→ suggestion ----
dotnet_diagnostic.CA1304.severity = suggestion # 指定 CultureInfo
dotnet_diagnostic.CA1305.severity = suggestion # 指定 IFormatProvider

# ---- Usage（日志模板等非关键用法）→ suggestion ----
dotnet_diagnostic.CA2253.severity = suggestion # 命名占位符不应为数字
dotnet_diagnostic.CA2254.severity = suggestion # 日志模板应为静态表达式
