<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TC.Tier.Products\TC.Tier.Products.csproj" />
    <ProjectReference Include="..\..\src\TC.Tier.Runtime\TC.Tier.Runtime.csproj" />
    <ProjectReference Include="..\..\src\TC.Tier.Core\TC.Tier.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ★ 共享基础设施链接（单一真源，禁止复制——惯例同对抗性测试项目）：
         BenchVolume（介质卷，Runtime.Benchmarks 真源）+ MemoryAsyncTransferPersistence（快照内存传输面，Wal 测试真源） -->
    <Compile Include="..\TC.Tier.Runtime.Benchmarks\Storage\BenchVolume.cs" Link="Storage\BenchVolume.cs" />
    <Compile Include="..\..\tests\TC.Tier.Products.Tests\Wal\MemoryAsyncTransferPersistence.cs" Link="Wal\MemoryAsyncTransferPersistence.cs" />
  </ItemGroup>
</Project>
