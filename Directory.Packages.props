<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="DotNext.IO" Version="5.26.2" />
    <PackageVersion Include="DotNext.Net.Cluster" Version="5.26.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="8.0.0" />
    <PackageVersion Include="System.IO.Pipelines" Version="8.0.0" />
    <!-- Database / Cache -->
    <PackageVersion Include="Microsoft.FASTER.Core" Version="2.6.5" />
    <!-- Code Generation
         ★ 2026-09-07 销案：4.9.2 与 SDK 8.0.130 的 Roslyn 4.8.0 版本错配 → CS9057 警告，
           源生成器静默拒载（Contracts/Core 的 [BinaryLayout] 编解码器零产出 → TierVolume 76 CS0103 错误）。
           降级 4.8.0 对齐 SDK Roslyn 文件版本 4.800.25.56925。 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Benchmarks (used by non-centralized .csproj, but version defined here for consistency) -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>
</Project>
