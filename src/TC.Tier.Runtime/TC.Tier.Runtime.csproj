<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>TC.Tier.Runtime</PackageId>
    <Description>TC.Tier 运行时——存储引擎（Options/Builder 装配）、结构层（Ring/Log/Index/Metadata/Mirror/Snapshot/SortedIndex）、TierFs 介质抽象（依赖 TC.Tier.Core + TC.Tier.Contracts）。</Description>
    <PackageTags>storage;kv;wal;ring;log;index;engine;runtime</PackageTags>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TC.Tier.Runtime</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <PackageId>TC.Tier.Runtime</PackageId>
    <Version>0.1.0-alpha</Version>
    <Description>TC.Tier 可组合存储运行时内核——IO引擎实现与4中间层。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TC.Tier.Core\TC.Tier.Core.csproj" />
    <ProjectReference Include="..\TC.Tier.CodeGen\TC.Tier.CodeGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TC.Tier.CodeGen.Analyzers\TC.Tier.CodeGen.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TC.Tier.Runtime.Tests" />
    <InternalsVisibleTo Include="TC.Tier.Runtime.AdversarialTests" />
    <InternalsVisibleTo Include="TC.Tier.Core.Tests" />
    <InternalsVisibleTo Include="TC.Tier.Runtime.Benchmarks" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
