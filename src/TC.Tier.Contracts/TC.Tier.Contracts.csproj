<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>TC.Tier.Contracts</PackageId>
    <Description>TC.Tier 契约层——逻辑地址、生命周期/恢复接口、存储引擎 IO 契约、结构层接口（不依赖实现，零依赖包）。</Description>
    <PackageTags>storage;kv;wal;ring;log;logical-address;contracts</PackageTags>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <PackageId>TC.Tier.Contracts</PackageId>
    <Description>TC.Tier 业务契约层——所有接口契约 + 数据契约（零实现，零抽象类）</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TC.Tier.CodeGen.Abstractions\TC.Tier.CodeGen.Abstractions.csproj" />
    <ProjectReference Include="..\TC.Tier.CodeGen\TC.Tier.CodeGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
