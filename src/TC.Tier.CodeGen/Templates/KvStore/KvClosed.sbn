            options.EnableRangeIndex
                ? global::TC.Tier.Products.Kv.TierKvAssembly.CreateRangeIndex(fs, options, ring)
                : null;
        var kv = new {{CLASS_NAME}}(ring, index, options, formatter ?? s_formatter, logger, rangeIndex);
        kv.Initialize(hints);
        await kv.WaitForReadyAsync(ct).ConfigureAwait(false);
        return kv;
    }

    /// <summary>内嵌 Ring 派生实现——派生肢获得 protected internal 构造权（开放泛型零构造，同 RingOfT 形态）。</summary>
