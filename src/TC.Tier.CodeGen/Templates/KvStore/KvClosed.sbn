        global::TC.Tier.Products.Kv.KvRecoveryHints hints = default,
        global::System.Threading.CancellationToken ct = default)
    {
        options ??= s_defaultOptions;
        var ring = new RingImpl(global::TC.Tier.Products.Kv.TierKvAssembly.RingSettings(fs, options), fs);
        global::TC.Tier.Contracts.Structures.IIndex<{{KEY_FQN}}> index = options.IndexKind switch
        {
            global::TC.Tier.Products.Kv.KvIndexKind.Hash => new HashIndexImpl(
