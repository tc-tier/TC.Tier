    /// <summary>编码到 <see cref="System.Buffers.IBufferWriter{Byte}"/>（零拷贝汇——PipeWriter 直写形态）。</summary>
    public static void Encode(System.Buffers.IBufferWriter<byte> writer, in {{TYPE_NAME}} value)
    {
        var len = ComputeLength(in value);
        var span = writer.GetSpan(len);
        Encode(span, in value);
        writer.Advance(len);
    }
