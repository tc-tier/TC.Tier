    /// <summary>编码到 <see cref="System.Buffers.IBufferWriter{Byte}"/>（零拷贝汇——PipeWriter 直写形态）。</summary>
    public static void Encode(System.Buffers.IBufferWriter<byte> writer, {{ROOT_NAME}} message)
    {
        var len = ComputeLength(message);
        var span = writer.GetSpan(len);
        EncodeInto(span, message);
        writer.Advance(len);
    }
