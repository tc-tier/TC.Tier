    /// <summary>虚拟文件系统载体路径（'/dev/…' 首段制设备形态）。</summary>
    public static VirtualSpec Virtual(string path) => new(TierSpec.Parse($"virtual://{path}"));

    /// <summary>网络文件系统（s3：endpoint[:port] / bucket / key 前缀）。</summary>
    public static NetworkSpec Network(string endpoint, string bucket, string keyPrefix = "")
        => new(TierSpec.Parse($"network:///s3/{endpoint}/{bucket}/{keyPrefix}"));
