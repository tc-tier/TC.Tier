/// <summary>{{REMARK}}——With 方法集 = [SpecParam] 派生（TierSpec 属性面）。</summary>
public sealed class {{CLASS_NAME}}
{
    private TierSpec _spec;
    internal {{CLASS_NAME}}(TierSpec spec) => _spec = spec;
{{METHODS}}    /// <summary>只读挂载糖（access=ro）。</summary>
    public {{CLASS_NAME}} ReadOnly() => Access(AccessMode.Read);
    /// <summary>纯摄入挂载糖（access=wo）。</summary>
