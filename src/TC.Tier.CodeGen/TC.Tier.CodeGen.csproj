<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IsPackable>true</IsPackable>
    <PackageId>TC.Tier.CodeGen</PackageId>
    <Description>TC.Tier 源生成器——BinaryLayout 布局生成 + TierFs 协议注册桥（编译期生成，零运行时反射；作为 analyzer 包引用）。</Description>
    <PackageTags>storage;source-generator;codegen;binary-layout</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TC.Tier.CodeGen</RootNamespace>
    <AssemblyName>TC.Tier.CodeGen</AssemblyName>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- 生成器生成源码用插值字符串拼注释/提示，非用户可见区域性文本 -->
    <NoWarn>$(NoWarn);CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- ★ analyzer 包形态：dll 进 analyzers/dotnet/cs（消费方编译期加载，不引用程序集） -->
  <ItemGroup>
    <None Include="bin/$(Configuration)/net8.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
