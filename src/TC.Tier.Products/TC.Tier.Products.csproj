<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>TC.Tier.Products</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <IsPackable>true</IsPackable>
    <PackageId>TC.Tier.Products</PackageId>
    <Description>TC.Tier 官方产品——TierKV/WAL/Blob/Queue，基于可组合运行时内核。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TC.Tier.Runtime\TC.Tier.Runtime.csproj" />
    <ProjectReference Include="..\TC.Tier.Core\TC.Tier.Core.csproj" />
    <ProjectReference Include="..\TC.Tier.CodeGen\TC.Tier.CodeGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TC.Tier.Products.Tests" />
    <InternalsVisibleTo Include="TC.Tier.Products.Benchmarks" />
    <!-- ★ 对抗性项目白名单（§4.1——Core/Runtime 同款先例）：sweep 水位/回收线取证面 -->
    <InternalsVisibleTo Include="TC.Tier.Runtime.AdversarialTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
</Project>
