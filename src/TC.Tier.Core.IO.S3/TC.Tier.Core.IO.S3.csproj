<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>TC.Tier.Core.IO.S3</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>TC.Tier.Core.IO.S3</PackageId>
    <Description>TC.Tier Core/IO 远程对象层——SigV4 自写的 S3 兼容 IObjectStore 实现（S3/OSS/MinIO/R2/B2，换 endpoint 即达；network:///s3 介质）</Description>
    <PackageTags>storage;s3;object-store;sigv4;network</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- ★ 零外部依赖铁律：仅引用 TC.Tier.Core（隔离网络副作用保 Core 纯计算；AOT/裁剪友好） -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TC.Tier.Core\TC.Tier.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TC.Tier.Core.IO.S3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ★ 程序集级协议导出标记（Tier 通用导出协议机制——2026-08-24 用户裁定方案 A）：
         声明本程序集导出网络协议——TierFsGenerator 在消费方编译里据此生成外部注册桥。
         csproj 声明与 AssemblyInfo.cs 等价（编译时合成程序集特性）——导出意图随项目定义 -->
    <AssemblyAttribute Include="TC.Tier.CodeGen.TierProtocolExportedAttribute" />
  </ItemGroup>
</Project>
